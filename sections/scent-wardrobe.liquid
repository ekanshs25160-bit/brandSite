<section class="py-32 bg-surface-container-low overflow-hidden">
  <div class="px-12 mb-20 max-w-screen-2xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <span class="font-label text-[10px] uppercase tracking-[0.3em] text-secondary mb-4 block">Occasion-Based</span>
      <h2 class="font-headline text-4xl md:text-5xl italic">Scent Wardrobe</h2>
    </div>
    <div class="flex gap-4">
      <button class="w-12 h-12 border border-outline-variant/40 flex items-center justify-center hover:bg-white transition-colors">
        <span class="material-symbols-outlined text-sm" data-icon="arrow_back">arrow_back</span>
      </button>
      <button class="w-12 h-12 border border-outline-variant/40 flex items-center justify-center hover:bg-white transition-colors">
        <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
      </button>
    </div>
  </div>

  <div class="flex gap-12 overflow-x-auto hide-scrollbar px-12 pb-12">
    {% for collection in section.settings.collections %}
      {% capture margin_class %}{% cycle '', 'mt-10 md:mt-20', '' %}{% endcapture %}
      <div class="flex-none w-[320px] md:w-[400px] {{ margin_class }}">
        <div class="aspect-[4/5] bg-surface-container-highest overflow-hidden mb-6">
          {% if collection.image %}
            <img class="w-full h-full object-cover" src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title }}">
          {% elsif collection.products.first.featured_image %}
            <img class="w-full h-full object-cover" src="{{ collection.products.first.featured_image | image_url: width: 600 }}" alt="{{ collection.title }}">
          {% else %}
            {{ 'collection-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-neutral-200 text-neutral-400' }}
          {% endif %}
        </div>
        <h3 class="font-headline text-2xl mb-2">{{ collection.title }}</h3>
        <p class="text-on-surface-variant font-light text-sm mb-6">
          {{ collection.description | strip_html | truncatewords: 15 }}
        </p>
        <a href="{{ collection.url }}" class="text-primary font-label text-[10px] uppercase tracking-widest border-b border-primary pb-1 inline-block">
          Shop Series
        </a>
      </div>
    {% else %}
      {% for i in (1..3) %}
        {% capture margin_class %}{% cycle '', 'mt-10 md:mt-20', '' %}{% endcapture %}
        <div class="flex-none w-[320px] md:w-[400px] {{ margin_class }}">
          <div class="aspect-[4/5] bg-surface-container-highest overflow-hidden mb-6">
            {{ 'collection-' | append: i | placeholder_svg_tag: 'w-full h-full object-cover bg-neutral-200 text-neutral-400' }}
          </div>
          <h3 class="font-headline text-2xl mb-2">Collection Title</h3>
          <p class="text-on-surface-variant font-light text-sm mb-6">
            Add a description to your collection to display it here.
          </p>
          <a href="#" class="text-primary font-label text-[10px] uppercase tracking-widest border-b border-primary pb-1 inline-block">
            Shop Series
          </a>
        </div>
      {% endfor %}
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Scent Wardrobe Scroller",
  "settings": [
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 6
    }
  ],
  "presets": [
    {
      "name": "Scent Wardrobe Scroller"
    }
  ]
}
{% endschema %}
