<section class="py-32 bg-surface-container-low overflow-hidden">
  <div class="px-12 mb-20 max-w-screen-2xl mx-auto flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div>
      <span class="font-label text-[10px] uppercase tracking-[0.3em] text-secondary mb-4 block">Occasion-Based</span>
      <h2 class="font-headline text-4xl md:text-5xl italic">Scent Wardrobe</h2>
    </div>
    <div class="flex gap-4">
      <button class="w-12 h-12 border border-outline-variant/40 flex items-center justify-center hover:bg-white transition-colors">
        <span class="material-symbols-outlined text-sm" data-icon="arrow_back">arrow_back</span>
      </button>
      <button class="w-12 h-12 border border-outline-variant/40 flex items-center justify-center hover:bg-white transition-colors">
        <span class="material-symbols-outlined text-sm" data-icon="arrow_forward">arrow_forward</span>
      </button>
    </div>
  </div>

  <div class="flex gap-12 overflow-x-auto hide-scrollbar px-12 pb-12">
    <!-- Card 1: Aligned Top -->
    <div class="flex-none w-[320px] md:w-[400px]">
      <div class="aspect-[4/5] bg-surface-container-highest overflow-hidden mb-6">
        <img
          class="w-full h-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuDP78So2BfjyOq6aorDrdmv3g1LI-YsSa6t6Jn6TtdCeVLJnl4Zgqz-eKeles_txeQ-q2W0_8gctZGkN4gfL2hzqPJzeSEunYS4muZ5AZuyFacH6wTqHh46HaUdHW0hfbhGy7G85p8eNREoM3BuLVxTvBX_FE-39On33RmmCKugPcA8fW5U8jTE0Wzl_gXivVjzvgnRebesD9clZkQmB_X9n0M_w-k-B4xzD-9xbLq9KXOJMEZ9v0HhaJe9p2e1jZ98l-A8aUcbclo"
          alt="The Professional"
        >
      </div>
      <h3 class="font-headline text-2xl mb-2">The Professional</h3>
      <p class="text-on-surface-variant font-light text-sm mb-6">
        Clean linen, white iris, and vetiver. Subtle yet commanding.
      </p>
      <button class="text-primary font-label text-[10px] uppercase tracking-widest border-b border-primary pb-1">
        Shop Series
      </button>
    </div>

    <!-- Card 2: Offset Down -->
    <div class="flex-none w-[320px] md:w-[400px] mt-10 md:mt-20">
      <div class="aspect-[4/5] bg-surface-container-highest overflow-hidden mb-6">
        <img
          class="w-full h-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuAwVNiBoVEdCUdV1H5OZsYhzwaUCgP3P8yJOXWPAcSfU_V8mrfkqQ5DH4Y20LrOF0l8GyMCS829Z7_49IaWwK9hAWeq3n1w4YA7NTVBwg64qe0JZbSIT3iHyuB71QRD8vHh9nYI1FDMbSMUxfpu2lIl_EgwqBHnbfLwZUw9brt9NqpTreAndXDu2z6gpidPr0JKGicW-0PtTfnmoDLF7Fm9Cft4FupajAM-XnTY5HdMz28AfEST0qTkUFZ_X6n8G6zvgbwVVCXgno8"
          alt="The Midnight Series"
        >
      </div>
      <h3 class="font-headline text-2xl mb-2">The Midnight Series</h3>
      <p class="text-on-surface-variant font-light text-sm mb-6">
        Smoky oud, dark plum, and leather. For the hours of mystery.
      </p>
      <button class="text-primary font-label text-[10px] uppercase tracking-widest border-b border-primary pb-1">
        Shop Series
      </button>
    </div>

    <!-- Card 3: Aligned Top -->
    <div class="flex-none w-[320px] md:w-[400px]">
      <div class="aspect-[4/5] bg-surface-container-highest overflow-hidden mb-6">
        <img
          class="w-full h-full object-cover"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuBYcrrqyzTnIAgK7XHzpJxUylnSH3n6JjY0JbOIcbBFdIzAKeXDVH7RaHbDwOW4DjEe_RySPhioHQhYCMnkiguqCjtCHHiUMILBmcs1GWqbdUpTASwCXis3n9_OFKIKI4UK2Z3bkVIIkVVp00Z5AKN4NMIWOKsNQJKcqgtBWfgK8NhmPtT-DYE82F2xWLqO2d5-sQNDmiHKjw3jHg2XX59Hck1XTiubgRrczXOMFX3FjCR0SrW_I3ccyEGxMPmlBw__YTsNHUTeSww"
          alt="The Discovery Kit"
        >
      </div>
      <h3 class="font-headline text-2xl mb-2">The Discovery Kit</h3>
      <p class="text-on-surface-variant font-light text-sm mb-6">
        Five signature scents to find your true olfactory identity.
      </p>
      <button class="text-primary font-label text-[10px] uppercase tracking-widest border-b border-primary pb-1">
        Shop Series
      </button>
    </div>
  </div>
</section>

