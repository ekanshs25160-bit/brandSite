{% style %}
  #shopify-section-{{ section.id }} {
    --blog-heading-scale: {{ section.settings.heading_scale }};
    --blog-gutter: {{ section.settings.post_spacing }}px;
    --blog-bg: {{ section.settings.bg_color | default: '#fdf9f4' }};
    --blog-primary: {{ section.settings.primary_color | default: '#2D004B' }};
    --blog-accent: {{ section.settings.accent_color | default: '#D4AF37' }};
    --blog-text: {{ section.settings.text_color | default: '#1c1b19' }};
    --blog-text-muted: {{ section.settings.text_muted_color | default: '#4c444f' }};
  }

  #shopify-section-{{ section.id }} .bg-background { background-color: var(--blog-bg); }
  #shopify-section-{{ section.id }} .text-brand-maroon { color: var(--blog-primary); }
  #shopify-section-{{ section.id }} .text-brand-gold { color: var(--blog-accent); }
  #shopify-section-{{ section.id }} .border-brand-maroon { border-color: var(--blog-primary); }
  #shopify-section-{{ section.id }} .border-brand-gold { border-color: var(--blog-accent); }
  #shopify-section-{{ section.id }} .bg-brand-maroon { background-color: var(--blog-primary); }
  #shopify-section-{{ section.id }} .text-on-surface-variant { color: var(--blog-text-muted); }
  #shopify-section-{{ section.id }} .text-on-background { color: var(--blog-text); }

  .material-symbols-outlined {
    font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
  }
{% endstyle %}

<main class="bg-background text-on-background min-h-screen font-body-md text-body-md antialiased selection:bg-brand-maroon selection:text-white">
  
  {% if section.settings.show_categories %}
    {%- assign nav_blog = section.settings.blog | default: blog -%}
    {% if nav_blog != blank %}
      <!-- 1. Sub Navigation Bar (Categories) -->
      <div class="bg-background dark:bg-on-background full-width border-b border-secondary/10 flat no shadows sticky top-[72px] md:top-[89px] z-40 bg-opacity-95 backdrop-blur-sm">
        <div class="flex items-center w-full py-4 gap-8 overflow-x-auto max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop hide-scrollbar">
          <a class="font-nav-label text-[10px] uppercase tracking-[0.15em] {% if current_tags == null %}text-brand-gold font-bold{% else %}text-on-surface-variant hover:text-brand-maroon{% endif %} underline-offset-4 hover:underline whitespace-nowrap" href="{{ nav_blog.url }}">
            {{ section.settings.all_essays_label | default: "ALL ESSAYS" }}
          </a>
          {% for tag in nav_blog.all_tags %}
            <a class="font-nav-label text-[10px] uppercase tracking-[0.15em] {% if current_tags contains tag %}text-brand-gold font-bold{% else %}text-on-surface-variant hover:text-brand-maroon{% endif %} underline-offset-4 hover:underline whitespace-nowrap" href="{{ nav_blog.url }}/tagged/{{ tag | handle }}">
              {{ tag | uppercase }}
            </a>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  {% endif %}

  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-12 md:py-16">
    
    <!-- Hero Selection Logic -->
    {% if section.settings.show_hero %}
      {%- assign hero_article = section.settings.hero_article -%}
      {%- if hero_article == blank -%}
        {%- assign hero_article = blog.articles.first -%}
      {%- endif -%}

      {% if hero_article != blank %}
        <!-- 2. Hero Section (Featured Article) -->
        <section class="grid grid-cols-1 md:grid-cols-12 gap-gutter mb-16 md:mb-32 items-center">
          <div class="col-span-1 md:col-span-8 relative aspect-[16/9] md:h-[600px] lg:h-[800px] overflow-hidden">
            {%- assign hero_img = section.settings.hero_image | default: hero_article.image -%}
            {% if hero_img %}
              <img src="{{ hero_img | image_url: width: 2000 }}" alt="{{ hero_article.title }}" class="absolute inset-0 w-full h-full object-cover object-center border border-brand-maroon/20 hover:scale-105 transition-transform duration-1000">
            {% else %}
              <img src="{{ 'journal-hero.jpg' | asset_url }}" alt="{{ hero_article.title }}" class="absolute inset-0 w-full h-full object-cover object-center border border-brand-maroon/20">
            {% endif %}
          </div>
          {% unless section.settings.hide_article_text %}
            <div class="col-span-1 md:col-span-4 flex flex-col justify-center px-0 mt-8 md:mt-0">
              <span class="font-data-sm text-[10px] text-brand-gold uppercase tracking-[0.15em] mb-4 block">
                {{ hero_article.tags.first | default: "Featured Story" }}
              </span>
              <h1 class="font-headline-xl text-3xl md:text-5xl lg:text-6xl text-brand-maroon mb-6 leading-tight">
                {{ hero_article.title }}
              </h1>
              <p class="font-nav-label text-[14px] leading-relaxed text-on-surface-variant mb-10 normal-case font-normal">
                {{ hero_article.excerpt_or_content | strip_html | truncatewords: 35 }}
              </p>
              <a class="inline-flex items-center group self-start" href="{{ hero_article.url }}">
                <span class="font-nav-label text-[10px] text-brand-maroon border-b border-brand-gold pb-1 group-hover:text-primary transition-colors tracking-widest uppercase">
                  {{ section.settings.read_more_label | default: "DISCOVER THE STORY" }}
                </span>
                <span class="material-symbols-outlined ml-2 text-brand-gold group-hover:text-brand-maroon transition-colors text-[18px]">arrow_right_alt</span>
              </a>
            </div>
          {% endunless %}
        </section>
      {% endif %}
    {% endif %}

    <!-- Grid Content Logic -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-start">
      {%- assign block_count = 0 -%}
      
      {%- if section.blocks.size > 0 -%}
        <!-- Render Curated Blocks (Articles or Images) -->
        {%- for block in section.blocks -%}
          {%- assign block_count = block_count | plus: 1 -%}
          {%- assign mod = block_count | modulo: 4 -%}

          {% if section.settings.show_newsletter and block_count == 3 %}
            {% render 'newsletter-interruption', section: section %}
          {% endif %}

          {% if block.type == 'article' %}
            {%- assign article = block.settings.article -%}
            {% if article != blank %}
              {% capture article_classes %}
                {% if mod == 1 %}col-span-1 md:col-span-5{% elsif mod == 2 %}col-span-1 md:col-span-7 {% if section.settings.enable_masonry %}md:mt-32{% endif %}{% elsif mod == 3 %}col-span-1 md:col-span-4{% else %}col-span-1 md:col-span-6 {% if section.settings.enable_masonry %}md:mt-24{% endif %}{% endif %}
              {% endcapture %}

              {% capture aspect_ratio %}
                {% if mod == 1 %}aspect-[4/5]{% elsif mod == 2 %}aspect-[16/9]{% elsif mod == 3 %}aspect-[3/4]{% else %}aspect-square{% endif %}
              {% endcapture %}

              {% if mod == 0 and section.settings.enable_masonry %}
                <div class="hidden md:block md:col-span-2"></div>
              {% endif %}

              <article class="{{ article_classes | strip }} group cursor-pointer" {{ block.shopify_attributes }}>
                <a href="{{ article.url }}" class="block relative overflow-hidden mb-6 {{ aspect_ratio }} border border-brand-maroon/10">
                  {%- assign art_img = block.settings.image | default: article.image -%}
                  {% if art_img %}
                    <img src="{{ art_img | image_url: width: 1200 }}" alt="{{ article.title }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 {% if mod == 2 %}grayscale hover:grayscale-0{% endif %}">
                  {% else %}
                    {% assign fallback = 'journal-article-' | append: mod | replace: '0', '4' | append: '.jpg' %}
                    <img src="{{ fallback | asset_url }}" alt="{{ article.title }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 {% if mod == 2 %}grayscale hover:grayscale-0{% endif %}">
                  {% endif %}
                  <div class="absolute inset-0 bg-brand-maroon/0 group-hover:bg-brand-maroon/10 transition-colors duration-500"></div>
                </a>
                {% unless section.settings.hide_article_text %}
                  <div class="{% if mod == 0 %}pl-8 border-l border-brand-gold/30{% endif %}">
                    <span class="font-data-sm text-[10px] text-brand-gold uppercase tracking-[0.15em] block mb-3">{{ article.tags.first | default: "Journal" }}</span>
                    <h3 class="font-headline-lg text-2xl md:text-3xl text-brand-maroon mb-3 group-hover:opacity-80 transition-opacity">
                      <a href="{{ article.url }}">{{ article.title }}</a>
                    </h3>
                    <p class="font-nav-label text-[13px] text-on-surface-variant mb-4 normal-case font-normal leading-relaxed">
                      {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
                    </p>
                    <a href="{{ article.url }}" class="font-nav-label text-[10px] text-brand-maroon border-b border-brand-gold pb-0.5 inline-block tracking-widest uppercase">READ MORE</a>
                  </div>
                {% endunless %}
              </article>
            {% endif %}

          {% elsif block.type == 'editorial_image' %}
            <div class="col-span-1 md:col-span-{{ block.settings.col_span_desktop }} {{ block.settings.margin_top_desktop }} px-0" {{ block.shopify_attributes }}>
              <div class="relative overflow-hidden {{ block.settings.aspect_ratio }} border border-brand-maroon/10">
                {% if block.settings.image %}
                  <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-1000">
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'w-full h-full object-cover opacity-20 bg-surface-container' }}
                {% endif %}
              </div>
            </div>
          {% endif %}
        {%- endfor -%}

      {%- else -%}
        <!-- Fallback to Automatic Blog Loop if no blocks are added -->
        {%- assign current_blog = section.settings.blog | default: blog -%}
        {%- if current_blog != blank -%}
          {%- for article in current_blog.articles offset: 1 -%}
            {%- assign loop_index = forloop.index -%}
            {%- assign mod = loop_index | modulo: 4 -%}
            
            {% if section.settings.show_newsletter and loop_index == 3 %}
              {% render 'newsletter-interruption', section: section %}
            {% endif %}

            {% capture article_classes %}
              {% if mod == 1 %}col-span-1 md:col-span-5{% elsif mod == 2 %}col-span-1 md:col-span-7 {% if section.settings.enable_masonry %}md:mt-32{% endif %}{% elsif mod == 3 %}col-span-1 md:col-span-4{% else %}col-span-1 md:col-span-6 {% if section.settings.enable_masonry %}md:mt-24{% endif %}{% endif %}
            {% endcapture %}

            {% capture aspect_ratio %}
              {% if mod == 1 %}aspect-[4/5]{% elsif mod == 2 %}aspect-[16/9]{% elsif mod == 3 %}aspect-[3/4]{% else %}aspect-square{% endif %}
            {% endcapture %}

            {% if mod == 0 and section.settings.enable_masonry %}
              <div class="hidden md:block md:col-span-2"></div>
            {% endif %}

            <article class="{{ article_classes | strip }} group cursor-pointer">
              <a href="{{ article.url }}" class="block relative overflow-hidden mb-6 {{ aspect_ratio }} border border-brand-maroon/10">
                {% if article.image %}
                  <img src="{{ article.image | image_url: width: 1200 }}" alt="{{ article.title }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 {% if mod == 2 %}grayscale hover:grayscale-0{% endif %}">
                {% else %}
                  {% assign fallback = 'journal-article-' | append: mod | replace: '0', '4' | append: '.jpg' %}
                  <img src="{{ fallback | asset_url }}" alt="{{ article.title }}" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105 opacity-80 {% if mod == 2 %}grayscale hover:grayscale-0{% endif %}">
                {% endif %}
              </a>
              {% unless section.settings.hide_article_text %}
                <div class="{% if mod == 0 %}pl-8 border-l border-brand-gold/30{% endif %}">
                  <h3 class="font-headline-lg text-2xl md:text-3xl text-brand-maroon mb-3"><a href="{{ article.url }}">{{ article.title }}</a></h3>
                  <a href="{{ article.url }}" class="font-nav-label text-[10px] text-brand-maroon border-b border-brand-gold pb-0.5 inline-block tracking-widest uppercase">READ MORE</a>
                </div>
              {% endunless %}
            </article>
          {%- endfor -%}
        {%- endif -%}
      {%- endif -%}
    </div>

  </div>
</main>

{% schema %}
{
  "name": "Aromaras Editorial Blog",
  "settings": [
    {
      "type": "header",
      "content": "Curated Hero"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show Featured Hero Article",
      "default": true
    },
    {
      "type": "article",
      "id": "hero_article",
      "label": "Hero Article",
      "info": "Override the hero article. If empty, uses the first article from the selected blog."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero Image Override",
      "info": "Override the featured image for the hero."
    },
    {
      "type": "header",
      "content": "Global Settings"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Fallback Blog",
      "info": "Used if no blocks are added below."
    },
    {
      "type": "checkbox",
      "id": "hide_article_text",
      "label": "Hide Labels and Text (Gallery Mode)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_masonry",
      "label": "Enable Masonry Grid Offsets",
      "default": true
    },
    {
      "type": "range",
      "id": "post_spacing",
      "min": 16,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Grid Spacing (Gutter)",
      "default": 32
    },
    {
      "type": "header",
      "content": "Color Palette"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf9f4"
    },
    {
      "type": "color",
      "id": "primary_color",
      "label": "Primary Color (Maroon)",
      "default": "#2D004B"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent Color (Gold)",
      "default": "#D4AF37"
    },
    {
      "type": "header",
      "content": "Newsletter Interruption"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter Interruption",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_title",
      "label": "Newsletter Title",
      "default": "The Private Compendium"
    },
    {
      "type": "textarea",
      "id": "newsletter_description",
      "label": "Newsletter Description",
      "default": "Join the inner circle."
    },
    {
      "type": "text",
      "id": "newsletter_button_label",
      "label": "Button Label",
      "default": "SUBSCRIBE"
    },
    {
      "type": "text",
      "id": "newsletter_icon",
      "label": "Material Icon Name",
      "default": "drafts"
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "text",
      "id": "all_essays_label",
      "label": "All Essays Label",
      "default": "ALL ESSAYS"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Hero Button Label",
      "default": "DISCOVER THE STORY"
    }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Featured Article",
      "settings": [
        {
          "type": "article",
          "id": "article",
          "label": "Article"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image Override",
          "info": "Override the featured image for this specific grid item."
        }
      ]
    },
    {
      "type": "editorial_image",
      "name": "Editorial Image Only",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "aspect_ratio",
          "label": "Aspect Ratio",
          "options": [
            { "value": "aspect-[4/5]", "label": "4:5 Portrait" },
            { "value": "aspect-[16/9]", "label": "16:9 Landscape" },
            { "value": "aspect-[3/4]", "label": "3:4 Editorial" },
            { "value": "aspect-square", "label": "1:1 Square" }
          ],
          "default": "aspect-square"
        },
        {
          "type": "range",
          "id": "col_span_desktop",
          "min": 2,
          "max": 12,
          "step": 1,
          "label": "Desktop Column Span",
          "default": 4
        },
        {
          "type": "select",
          "id": "margin_top_desktop",
          "label": "Vertical Offset",
          "options": [
            { "value": "md:mt-0", "label": "None" },
            { "value": "md:mt-12", "label": "Small" },
            { "value": "md:mt-24", "label": "Medium" },
            { "value": "md:mt-32", "label": "Large" }
          ],
          "default": "md:mt-0"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aromaras Editorial Journal",
      "blocks": [
        { "type": "article" },
        { "type": "article" },
        { "type": "article" },
        { "type": "article" }
      ]
    }
  ]
}
{% endschema %}
