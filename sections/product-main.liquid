<section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop grid grid-cols-1 md:grid-cols-2 gap-gutter pt-16 md:pt-24 bg-background">
  <!-- Left: Product Imagery -->
  <div class="w-full space-y-gutter">
    <div class="aspect-[4/5] bg-surface-container-low overflow-hidden border border-brand-maroon/10">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-1000">
      {% else %}
        <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAA_GW6L_ff4lYsAVuz-tRgiJ_zGcNhcqKtjqZbVMAcg45NsulJmIH9Zcqy_IoTAI50fMT9XQYrKUB10Dgm5cBe9hDZUiOc1fFNTo8aS4Y-uVp15EGF42W-wkZuIOXyC8uFYHmw_NbTlgxQExp7tPhrCYa48ivmpcwaq5nmRja4FTC-b4mKAojPNhZ10EvDhkHIx30BdQdQj_iIGxA7DbkDhkleKBkECaSnbilBa1LUo-L38CSV45qL6su7zRfgSIQI09-4vkwrc_I" alt="{{ product.title }}" class="w-full h-full object-cover">
      {% endif %}
    </div>
    <div class="grid grid-cols-2 gap-gutter">
      {% for image in product.images limit: 2 offset: 1 %}
        <div class="aspect-[4/5] bg-surface-container-low border border-brand-maroon/10 overflow-hidden">
          <img src="{{ image | image_url: width: 800 }}" alt="{{ product.title }}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-1000">
        </div>
      {% else %}
        {% comment %} Fallback images with consistent editorial styling {% endcomment %}
        <div class="aspect-[4/5] bg-surface-container-low border border-brand-maroon/10 overflow-hidden">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCPhac3xfxs-Caa_n92GdhTLpflK2Y7Ul4l_8mcmmZmlbPOT6FLSa_Vif5MTC13YUi5q69X-C_a38WhIyg2H7q3JfEtgOGYKMf4VirjOMWi536OaPToPzXEst33k0r6GlQruVE3FAu-o3h-DRFO4c0z8jWRV74VJ8jscZQuKYYf5umUQt1i0Qe8z_D9AkwwUy1dfMgkB-rUC5w0lKeesZuaDEF7Bf9X0ovjkI0ssl4iaRHAQCE_hGjqEjoHXkdKxMp-lPpddTrFR1Y" alt="Detail View" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700">
        </div>
        <div class="aspect-[4/5] bg-surface-container-low border border-brand-maroon/10 overflow-hidden">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuDtMWG2qyZXgQzpzTNN9O4PTXGVHIGQYSBC8wy-AXRC_Oz9xPnF7bc_iMvzQgxJUpKkNm4-83EA1d30nJPQDuzoB3pd3yBkzWcj4yh1D2fp3jBFdhmvbYgOQ9S6ZKCpEabpLW_T6u1SQTtkLkv35XagMK6AsoMmxbIe4BPWy7V39uaOgOEh5tqa6Wa_8KWc_dappgqGlmzXMX43ARFn3y6V8_jDOP-Z5UY5jCZ6mkfdCSN0Rv3YH6SmyH3TR_QumXoycy_Y2qGkU3g" alt="Editorial Mood" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700">
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Right: Product Information -->
  <div class="md:sticky md:top-32 h-fit space-y-12 pb-20">
    <div class="space-y-4">
      <p class="font-data-sm text-[10px] tracking-[0.3em] uppercase text-brand-gold">
        {{ product.type | default: 'Maison Heritage' }}
      </p>
      <h1 class="font-display-lg text-4xl md:text-5xl lg:text-6xl text-brand-maroon uppercase tracking-tight">
        {{ product.title }}
      </h1>
      <p class="font-headline-lg italic text-on-surface-variant text-xl">
        "{{ product.metafields.custom.tagline | default: 'A symphony of nocturnal blooms and deep woods.' }}"
      </p>
      <p class="font-display-lg text-2xl text-brand-maroon">{{ product.price | money }}</p>
    </div>

    <div class="space-y-6">
      <p class="font-nav-label text-[10px] uppercase tracking-widest text-brand-gold">Select Volume</p>
      <div class="flex flex-wrap gap-4">
        {% for variant in product.variants %}
          <button class="px-8 py-3 {% if forloop.first %}bg-brand-maroon text-white shadow-xl{% else %}border border-brand-maroon/20 text-brand-maroon hover:border-brand-maroon{% endif %} font-nav-label text-[10px] tracking-widest uppercase transition-all duration-300">
            {{ variant.title }}
          </button>
        {% endfor %}
      </div>
    </div>

    <div class="space-y-8">
      <form method="post" action="/cart/add">
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" />
        <button type="submit" class="w-full bg-brand-maroon text-white py-5 font-nav-label text-[10px] uppercase tracking-[0.3em] hover:bg-black transition-all active:scale-95 duration-150">
          Experience the Scent
        </button>
      </form>
      <div class="font-body-md text-sm text-on-surface-variant leading-relaxed font-light prose prose-sm max-w-none">
        {{ product.description }}
      </div>
    </div>

    <!-- Quality Markers -->
    <div class="grid grid-cols-2 gap-8 pt-8 border-t border-brand-maroon/10">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-brand-gold">local_shipping</span>
        <span class="font-data-sm text-[10px] uppercase tracking-widest text-brand-maroon">Complimentary Shipping</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-brand-gold">auto_awesome</span>
        <span class="font-data-sm text-[10px] uppercase tracking-widest text-brand-maroon">Discovery Credit</span>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Main Info",
  "settings": []
}
{% endschema %}
