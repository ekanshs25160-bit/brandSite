<section class="bg-primary text-on-primary py-32 overflow-hidden">
  <div class="max-w-screen-2xl mx-auto px-12 flex flex-col md:flex-row gap-16 items-center">
    <div class="md:w-1/3">
      <h2 class="text-4xl font-serif mb-6">Perfect For Layering With...</h2>
      <p class="text-on-primary/70 text-sm leading-relaxed mb-8">
        {{ section.settings.description | default: "Create a bespoke scent trail by combining this fragrance with the ethereal nodes of another from our collection. Together they create a balanced dialogue of smoke and moonlight." }}
      </p>
      <button class="border border-on-primary/20 px-8 py-4 text-[10px] uppercase tracking-[0.3em] hover:bg-on-primary hover:text-primary transition-all">Shop the Duo</button>
    </div>
    <div class="md:w-2/3 grid grid-cols-2 gap-8">
      <div class="bg-surface-container-highest/10 p-8 flex flex-col items-center text-center">
        <div class="w-32 aspect-[4/5] bg-surface mb-6">
          <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuBXYcFzvXx44ax_eSmihDatl78xeKKpxIrQwY3-CC3hFyWL5fGKLSJ-PmXfV8fv584o9gYVNgBTkfv179CIuGj-ok71Yd2NWhh-AL4cPPk8-cVplrOrpXXJR4DVAir8h7WaNgcvcnIMKkWNMizcNj7cCOzbmurSqieLPv0yarWKnMn3bVxwgRLcSJrLnGf6YT5CBOGY-53vSmhvVtkA33s9hQ6eFhleJZW7TxqqRPAwg1aYq96xu6-VNyXLuY5HI_oQeYjGRmc_dE" alt="Layering product" class="w-full h-full object-cover">
        </div>
        <h4 class="font-serif italic text-lg">{{ section.settings.pair_title | default: 'CHANDNI' }}</h4>
        <p class="text-[10px] uppercase tracking-widest mt-2">White Floral & Musk</p>
      </div>
      <div class="bg-white/5 p-8 flex flex-col items-center justify-center text-center border border-white/10">
        <span class="material-symbols-outlined text-4xl mb-4">add</span>
        <p class="font-serif text-xl">The Midnight Collection</p>
        <p class="text-[10px] uppercase tracking-widest mt-4 opacity-70">Save 15% on the Bundle</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Layering Suggestion",
  "settings": [
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "pair_title",
      "label": "Pair Product Title"
    }
  ]
}
{% endschema %}
