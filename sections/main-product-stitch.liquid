{% comment %}
  Main Product Section for Aromaras - Ported from Stitch HTML
{% endcomment %}

<section class="max-w-screen-2xl mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-2 gap-16 pt-12">
  <!-- Left: Portrait Image & Gallery -->
  <div class="w-full">
    <div class="aspect-[4/5] bg-surface-container-low overflow-hidden">
      {%- if product.featured_media -%}
        <img 
          src="{{ product.featured_media | image_url: width: 1200 }}" 
          alt="{{ product.featured_media.alt | escape }}" 
          class="w-full h-full object-cover"
          loading="lazy"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'w-full h-full object-cover bg-neutral-100' }}
      {%- endif -%}
    </div>
    
    <div class="mt-8 grid grid-cols-2 gap-4">
      {%- for media in product.media offset: 1 limit: 2 -%}
        <div class="aspect-[4/5] bg-surface-container-low overflow-hidden">
          <img 
            src="{{ media | image_url: width: 800 }}" 
            alt="{{ media.alt | escape }}" 
            class="w-full h-full object-cover"
            loading="lazy"
          >
        </div>
      {%- endfor -%}
      {%- if product.media.size < 3 -%}
        {%- assign remaining = 3 | minus: product.media.size -%}
        {%- for i in (1..remaining) -%}
           <div class="aspect-[4/5] bg-surface-container-low overflow-hidden flex items-center justify-center">
             {{ 'image' | placeholder_svg_tag: 'w-1/2 h-1/2 opacity-20' }}
           </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>

  <!-- Right: Sticky Product Info -->
  <div class="md:sticky md:top-32 h-fit space-y-12 pb-20">
    <div class="space-y-4">
      <p class="font-sans text-[10px] tracking-[0.3em] uppercase text-on-surface-variant">
        {{ product.type | default: 'Extrait de Parfum' }}
      </p>
      <h1 class="text-6xl font-serif font-bold tracking-tight text-primary uppercase">
        {{ product.title }}
      </h1>
      {%- if product.metafields.custom.subtitle -%}
        <p class="text-xl font-serif italic text-on-surface-variant">"{{ product.metafields.custom.subtitle }}"</p>
      {%- else -%}
        <p class="text-xl font-serif italic text-on-surface-variant">"The Golden Hour in a bottle."</p>
      {%- endif -%}
      <p class="text-2xl font-medium" id="product-price">{{ product.selected_or_first_available_variant.price | money }}</p>
    </div>

    {%- form 'product', product, id: 'product-form', class: 'space-y-8' -%}
      <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      
      <div class="space-y-4">
        <p class="font-sans text-xs uppercase tracking-widest text-on-surface-variant">Select Volume</p>
        <div class="flex gap-4">
          {%- for variant in product.variants -%}
            <button 
              type="button"
              data-variant-id="{{ variant.id }}"
              data-price="{{ variant.price | money }}"
              class="variant-selector px-8 py-3 {% if variant.id == product.selected_or_first_available_variant.id %}bg-primary text-on-primary shadow-[0_4px_12px_rgba(75,29,29,0.2)]{% else %}bg-surface-container-high hover:bg-neutral-200{% endif %} text-xs tracking-widest uppercase transition-all duration-300"
            >
              {{ variant.title }}
            </button>
          {%- endfor -%}
        </div>
      </div>

      <div class="space-y-6">
        <button 
          type="submit" 
          name="add"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
          class="w-full bg-primary text-on-primary py-5 text-xs uppercase tracking-[0.25em] font-medium transition-all active:scale-95 duration-150 disabled:opacity-50 disabled:cursor-not-allowed"
        >
          {%- if product.selected_or_first_available_variant.available -%}
            Experience the Scent
          {%- else -%}
            Sold Out
          {%- endif -%}
        </button>
        <div class="text-sm text-on-surface-variant leading-relaxed font-light rte">
          {{ product.description }}
        </div>
      </div>
    {%- endform -%}

    <div class="grid grid-cols-2 gap-8 pt-8">
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">local_shipping</span>
        <span class="text-[10px] uppercase tracking-widest">Complimentary Shipping</span>
      </div>
      <div class="flex items-center gap-3">
        <span class="material-symbols-outlined text-primary">auto_awesome</span>
        <span class="text-[10px] uppercase tracking-widest">Discovery Credit</span>
      </div>
    </div>
  </div>
</section>

<!-- Olfactory Architecture -->
<section class="bg-surface-container-low mt-24 py-32">
  <div class="max-w-screen-2xl mx-auto px-12">
    <div class="text-center mb-20">
      <h2 class="text-4xl font-serif mb-4">The Olfactory Architecture</h2>
      <p class="text-on-surface-variant max-w-xl mx-auto font-light">A complex evolution that unfolds on the skin over twelve hours.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
      <!-- Top -->
      <div class="flex flex-col items-center text-center space-y-6">
        <div class="w-24 h-24 bg-surface-container-highest flex items-center justify-center">
          <span class="material-symbols-outlined text-4xl text-primary">air</span>
        </div>
        <div>
          <h3 class="text-xs uppercase tracking-[0.2em] mb-2 font-semibold">Top Notes</h3>
          <p class="font-serif italic text-lg">{{ product.metafields.custom.top_notes | default: 'Saffron, Bergamot, Pink Pepper' }}</p>
          <p class="text-[10px] uppercase mt-2 text-on-surface-variant">Immediate Impression (0-30 mins)</p>
        </div>
      </div>
      <!-- Heart -->
      <div class="flex flex-col items-center text-center space-y-6">
        <div class="w-24 h-24 bg-surface-container-highest flex items-center justify-center">
          <span class="material-symbols-outlined text-4xl text-primary">favorite</span>
        </div>
        <div>
          <h3 class="text-xs uppercase tracking-[0.2em] mb-2 font-semibold">Heart Notes</h3>
          <p class="font-serif italic text-lg">{{ product.metafields.custom.heart_notes | default: 'Oudh, Crimson Rose, Jasmine' }}</p>
          <p class="text-[10px] uppercase mt-2 text-on-surface-variant">The Scent Identity (1-4 hours)</p>
        </div>
      </div>
      <!-- Base -->
      <div class="flex flex-col items-center text-center space-y-6">
        <div class="w-24 h-24 bg-surface-container-highest flex items-center justify-center">
          <span class="material-symbols-outlined text-4xl text-primary">grass</span>
        </div>
        <div>
          <h3 class="text-xs uppercase tracking-[0.2em] mb-2 font-semibold">Base Notes</h3>
          <p class="font-serif italic text-lg">{{ product.metafields.custom.base_notes | default: 'Sandalwood, Vanilla, Amber' }}</p>
          <p class="text-[10px] uppercase mt-2 text-on-surface-variant">The Dry Down (4-12 hours)</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Scent Performance Matrix -->
<section class="max-w-screen-2xl mx-auto px-12 py-32 grid grid-cols-1 md:grid-cols-2 gap-24 items-center">
  <div>
    <h2 class="text-4xl font-serif mb-8">Scent Performance</h2>
    <div class="space-y-10">
      <div class="space-y-3">
        <div class="flex justify-between text-xs uppercase tracking-widest">
          <span>Longevity</span>
          <span>{{ product.metafields.custom.longevity_value | default: '12+ Hours' }}</span>
        </div>
        <div class="h-[1px] w-full bg-outline-variant/30 relative">
          <div class="absolute h-full bg-primary" style="width: {{ product.metafields.custom.longevity_percent | default: 95 }}%;"></div>
        </div>
      </div>
      <div class="space-y-3">
        <div class="flex justify-between text-xs uppercase tracking-widest">
          <span>Sillage</span>
          <span>{{ product.metafields.custom.sillage_value | default: 'Strong' }}</span>
        </div>
        <div class="h-[1px] w-full bg-outline-variant/30 relative">
          <div class="absolute h-full bg-primary" style="width: {{ product.metafields.custom.sillage_percent | default: 80 }}%;"></div>
        </div>
      </div>
      <div class="space-y-3">
        <div class="flex justify-between text-xs uppercase tracking-widest">
          <span>Authenticity</span>
          <span>{{ product.metafields.custom.authenticity_value | default: 'Artisanal' }}</span>
        </div>
        <div class="h-[1px] w-full bg-outline-variant/30 relative">
          <div class="absolute h-full bg-primary" style="width: {{ product.metafields.custom.authenticity_percent | default: 100 }}%;"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="aspect-[4/5] bg-surface-container overflow-hidden">
    {%- if product.metafields.custom.performance_image -%}
