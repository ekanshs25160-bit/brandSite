<script>
  document.querySelectorAll('.variant-selector').forEach(button => {
    button.addEventListener('click', function() {
      const variantId = this.dataset.variantId;
      const price = this.dataset.price;
      
      // Update hidden input
      document.querySelector('input[name="id"]').value = variantId;
      
      // Update price display
      document.getElementById('product-price').innerText = price;
      
      // Update UI state
      document.querySelectorAll('.variant-selector').forEach(btn => {
        btn.classList.remove('bg-primary', 'text-on-primary', 'shadow-[0_4px_12px_rgba(75,29,29,0.2)]');
        btn.classList.add('bg-surface-container-high', 'hover:bg-neutral-200');
      });
      
      this.classList.add('bg-primary', 'text-on-primary', 'shadow-[0_4px_12px_rgba(75,29,29,0.2)]');
      this.classList.remove('bg-surface-container-high', 'hover:bg-neutral-200');
    });
  });
</script>

{% schema %}
