{% style %}
  #shopify-section-{{ section.id }} {
    --header-bg: {{ section.settings.bg_color }};
    --header-text: {{ section.settings.text_color }};
    --header-logo-size: {{ section.settings.logo_size_desktop }}px;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --header-logo-size: {{ section.settings.logo_size_mobile }}px;
    }
  }
{% endstyle %}

<header class="border-b border-outline-variant/30 sticky top-0 z-50 transition-colors duration-300" style="background-color: var(--header-bg); color: var(--header-text);">
  <div class="flex justify-between items-center w-full px-4 md:px-12 py-5 md:py-6 max-w-screen-2xl mx-auto">
    <!-- Navigation Links (Left) -->
    <nav class="hidden md:flex gap-8 items-center flex-1">
      {% for link in section.settings.menu.links %}
        <a
          class="{% if link.active %}opacity-100 border-b border-current pb-1{% else %}opacity-60 hover:opacity-100{% endif %} transition-all font-label text-[10px] uppercase tracking-[0.2em]"
          href="{{ link.url }}"
          style="font-family: {{ section.settings.nav_font_family }};"
        >
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    <!-- Brand Logo (Center) -->
    <a 
      class="font-headline tracking-[0.2em] absolute left-1/2 transform -translate-x-1/2 whitespace-nowrap" 
      href="/" 
      style="font-family: {{ section.settings.logo_font_family }}; font-size: var(--header-logo-size);"
    >
      {{ section.settings.logo_text | default: shop.name | uppercase }}
    </a>

    <!-- Trailing Icons (Right) -->
    <div class="flex-1 flex justify-end items-center gap-6">
      {% if section.settings.show_search %}
        <button class="hover:opacity-60 transition-opacity">
          <span class="material-symbols-outlined text-base">search</span>
        </button>
      {% endif %}
      <button class="hover:opacity-60 transition-opacity">
        <span class="material-symbols-outlined text-base">shopping_bag</span>
      </button>
      <button class="md:hidden material-symbols-outlined text-base" id="mobile-menu-open">menu</button>
    </div>
  </div>
</header>

<!-- Mobile Menu Drawer (Simplified logic for now) -->
<div id="mobile-menu-overlay" class="fixed inset-0 z-[100] hidden">
  <div id="mobile-menu-backdrop" class="absolute inset-0 bg-black/40 backdrop-blur-sm"></div>
  <div id="mobile-menu-drawer" class="absolute top-0 right-0 h-full w-72 bg-white shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out">
    <div class="flex justify-between items-center px-6 py-6 border-b border-outline-variant/20">
      <span class="font-headline text-lg tracking-[0.3em]">{{ shop.name | uppercase }}</span>
      <button id="mobile-menu-close" class="material-symbols-outlined">close</button>
    </div>
    <nav class="flex flex-col px-6 py-8 gap-6 flex-1 overflow-y-auto">
      {% for link in section.settings.menu.links %}
        <a class="text-neutral-500 hover:text-neutral-900 transition-colors font-sans text-xs uppercase tracking-[0.2em] pb-1 w-fit" href="{{ link.url }}">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>
  </div>
</div>

<script>
  (function() {
    const overlay = document.getElementById('mobile-menu-overlay');
    const drawer = document.getElementById('mobile-menu-drawer');
    const openBtn = document.getElementById('mobile-menu-open');
    const closeBtn = document.getElementById('mobile-menu-close');

    if (openBtn) openBtn.addEventListener('click', () => {
      overlay.classList.remove('hidden');
      setTimeout(() => drawer.classList.remove('translate-x-full'), 10);
    });
    if (closeBtn) closeBtn.addEventListener('click', () => {
      drawer.classList.add('translate-x-full');
      setTimeout(() => overlay.classList.add('hidden'), 300);
    });
  })();
</script>

{% schema %}
{
  "name": "Aromaras Header",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf9f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1c1b"
    },
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "AROMARAS"
    },
    {
      "type": "text",
      "id": "logo_font_family",
      "label": "Logo Font Family",
      "default": "'EB Garamond', serif"
    },
    {
      "type": "range",
      "id": "logo_size_desktop",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Logo Size (Desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_size_mobile",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Logo Size (Mobile)",
      "default": 18
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "nav_font_family",
      "label": "Navigation Font Family",
      "default": "'Montserrat', sans-serif"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    }
  ]
}
{% endschema %}
