{% style %}
  #shopify-section-{{ section.id }} {
    --header-bg: {{ section.settings.bg_color }};
    --header-text: {{ section.settings.text_color }};
    --header-logo-size: {{ section.settings.logo_size_desktop }}px;
    position: sticky;
    top: 0;
    z-index: 50;
  }
  @media (max-width: 767px) {
    #shopify-section-{{ section.id }} {
      --header-logo-size: {{ section.settings.logo_size_mobile }}px;
    }
  }
  
  /* Ensure the header has a backdrop-blur and slight opacity for a premium feel */
  .header-glass {
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    background-color: {{ section.settings.bg_color | append: 'EE' }}; /* Adding some transparency */
  }
{% endstyle %}

<header class="border-b border-brand-maroon/10 header-glass transition-all duration-300 w-full" style="color: var(--header-text);">
  <div class="flex justify-between items-center w-full px-margin-mobile md:px-margin-desktop py-4 md:py-6 max-w-container-max mx-auto">
    <!-- Navigation Links (Left) -->
    <nav class="hidden md:flex gap-10 items-center flex-1">
      {% for link in section.settings.menu.links %}
        <a
          class="{% if link.active %}text-brand-gold border-b border-brand-gold pb-1{% else %}opacity-70 hover:opacity-100 hover:text-brand-maroon{% endif %} transition-all font-nav-label text-[10px] uppercase tracking-[0.2em] whitespace-nowrap"
          href="{{ link.url }}"
        >
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    <!-- Brand Logo (Center) -->
    <a 
      class="font-display-lg tracking-[0.25em] absolute left-1/2 transform -translate-x-1/2 whitespace-nowrap text-brand-maroon" 
      href="/" 
      style="font-size: var(--header-logo-size);"
    >
      {{ section.settings.logo_text | default: shop.name | uppercase }}
    </a>

    <!-- Trailing Icons (Right) -->
    <div class="flex-1 flex justify-end items-center gap-6 text-brand-maroon">
      {% if section.settings.show_search %}
        <button class="hover:text-brand-gold transition-colors">
          <span class="material-symbols-outlined text-[20px]">search</span>
        </button>
      {% endif %}
      <button class="hover:text-brand-gold transition-colors relative">
        <span class="material-symbols-outlined text-[20px]">shopping_bag</span>
        <span class="absolute -top-1 -right-1 bg-brand-gold text-white text-[8px] w-3.5 h-3.5 flex items-center justify-center rounded-full">0</span>
      </button>
      <button class="md:hidden material-symbols-outlined text-[24px]" id="mobile-menu-open">menu</button>
    </div>
  </div>
</header>

<!-- Mobile Menu Drawer -->
<div id="mobile-menu-overlay" class="fixed inset-0 z-[100] hidden">
  <div id="mobile-menu-backdrop" class="absolute inset-0 bg-brand-maroon/20 backdrop-blur-sm"></div>
  <div id="mobile-menu-drawer" class="absolute top-0 right-0 h-full w-80 bg-background border-l border-brand-maroon/10 shadow-2xl flex flex-col translate-x-full transition-transform duration-300 ease-out">
    <div class="flex justify-between items-center px-6 py-6 border-b border-brand-maroon/5">
      <span class="font-display-lg text-lg tracking-[0.3em] text-brand-maroon">{{ shop.name | uppercase }}</span>
      <button id="mobile-menu-close" class="material-symbols-outlined text-brand-gold">close</button>
    </div>
    <nav class="flex flex-col px-8 py-10 gap-8 flex-1 overflow-y-auto">
      {% for link in section.settings.menu.links %}
        <a class="text-on-surface-variant hover:text-brand-maroon transition-colors font-nav-label text-xs uppercase tracking-[0.2em] pb-1 w-fit border-b border-transparent hover:border-brand-gold" href="{{ link.url }}">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>
    <div class="p-8 border-t border-brand-maroon/5">
      <p class="font-data-sm text-[9px] uppercase tracking-widest text-brand-gold">Maison Aromaras © 2024</p>
    </div>
  </div>
</div>

<script>
  (function() {
    const overlay = document.getElementById('mobile-menu-overlay');
    const drawer = document.getElementById('mobile-menu-drawer');
    const openBtn = document.getElementById('mobile-menu-open');
    const closeBtn = document.getElementById('mobile-menu-close');
    const backdrop = document.getElementById('mobile-menu-backdrop');

    if (openBtn) openBtn.addEventListener('click', () => {
      overlay.classList.remove('hidden');
      setTimeout(() => drawer.classList.remove('translate-x-full'), 10);
      document.body.style.overflow = 'hidden';
    });
    
    const closeMenu = () => {
      drawer.classList.add('translate-x-full');
      setTimeout(() => {
        overlay.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    };

    if (closeBtn) closeBtn.addEventListener('click', closeMenu);
    if (backdrop) backdrop.addEventListener('click', closeMenu);
  })();
</script>

{% schema %}
{
  "name": "Aromaras Header",
  "settings": [
    {
      "type": "header",
      "content": "Appearance"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#faf9f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#1a1c1b"
    },
    {
      "type": "header",
      "content": "Brand Logo"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "AROMARAS"
    },
    {
      "type": "range",
      "id": "logo_size_desktop",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "label": "Logo Size (Desktop)",
      "default": 24
    },
    {
      "type": "range",
      "id": "logo_size_mobile",
      "min": 12,
      "max": 32,
      "step": 2,
      "unit": "px",
      "label": "Logo Size (Mobile)",
      "default": 18
    },
    {
      "type": "header",
      "content": "Navigation"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Menu",
      "default": "main-menu"
    },
    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    }
  ]
}
{% endschema %}
