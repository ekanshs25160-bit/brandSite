<section class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop py-24 md:py-32 grid grid-cols-1 md:grid-cols-2 gap-gutter items-center">
  <div class="order-2 md:order-1">
    <h2 class="font-headline-xl text-3xl md:text-5xl text-brand-maroon mb-12">Scent Performance</h2>
    <div class="space-y-12">
      <!-- Longevity -->
      <div class="space-y-4">
        <div class="flex justify-between font-nav-label text-[10px] uppercase tracking-widest text-brand-maroon">
          <span>Longevity</span>
          <span class="text-brand-gold font-bold">12+ Hours</span>
        </div>
        <div class="h-[1px] w-full bg-brand-maroon/10 relative">
          <div class="absolute h-full bg-brand-maroon w-[95%]"></div>
        </div>
      </div>
      <!-- Sillage -->
      <div class="space-y-4">
        <div class="flex justify-between font-nav-label text-[10px] uppercase tracking-widest text-brand-maroon">
          <span>Sillage</span>
          <span class="text-brand-gold font-bold">Strong</span>
        </div>
        <div class="h-[1px] w-full bg-brand-maroon/10 relative">
          <div class="absolute h-full bg-brand-maroon w-[80%]"></div>
        </div>
      </div>
      <!-- Authenticity -->
      <div class="space-y-4">
        <div class="flex justify-between font-nav-label text-[10px] uppercase tracking-widest text-brand-maroon">
          <span>Authenticity</span>
          <span class="text-brand-gold font-bold">Artisanal</span>
        </div>
        <div class="h-[1px] w-full bg-brand-maroon/10 relative">
          <div class="absolute h-full bg-brand-maroon w-[100%]"></div>
        </div>
      </div>
    </div>
  </div>
  <div class="order-1 md:order-2 aspect-[4/5] bg-surface-container overflow-hidden border border-brand-maroon/10">
    {% if section.settings.image %}
      <img src="{{ section.settings.image | image_url: width: 1000 }}" alt="Performance Detail" class="w-full h-full object-cover hover:scale-105 transition-transform duration-1000">
    {% else %}
      <img src="https://lh3.googleusercontent.com/aida-public/AB6AXuCodBiVjx-kU6WkVzvunxudsVCWdf7s6fkTC_Wt7NqsKXgD1NeBX6NE8nDAKhELy0U6gjBFovOq7pBZX4JDAbfj_lNQrPpS_8_KTlejAM0H6ajWCmTnQuujytLT3Eafu7v2CUg6TAefVp_drR_lEwNcwYlqkn8QiWQcb5T-Y-lSYnRpTRKQ6jBoxXCPsuRG9pxZUbVVlM5YiDDkPo-sRybXiCyGlQsZskZF9g26d0_fyeHdM_4vcxWLSGJkGQXMWJbjiA81HzGwQW0" alt="Saffron Macro" class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700">
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Performance Matrix",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Macro Image"
    }
  ]
}
{% endschema %}
