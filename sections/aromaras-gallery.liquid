<section class="py-16 md:py-32 px-4 md:px-12 bg-surface">
  <div class="max-w-screen-2xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-10 gap-8 md:gap-12 items-start">
      <!-- Feature Block -->
      <div class="md:col-span-6 relative group">
        <div class="aspect-[4/5] overflow-hidden bg-surface-container">
          <img
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
