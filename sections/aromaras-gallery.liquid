              alt="Oudh Imperial"
            >
          </div>
          <div class="mt-4 md:mt-6 flex justify-between items-end">
            <div>
              <span class="font-label text-[10px] uppercase tracking-widest text-secondary mb-1 block"
                >Limited Release</span
