            alt="Feature Image"
          >
        </div>
        <!-- On mobile: static card below image. On md+: absolute overlay card -->
        <div class="mt-6 md:mt-0 bg-white p-6 md:p-12 shadow-2xl shadow-neutral-900/5 md:absolute md:-bottom-12 md:-right-12 md:max-w-md">
          <h2 class="font-headline text-2xl md:text-3xl mb-4 italic">The Signature Icons</h2>
          <p class="text-on-surface-variant leading-relaxed text-sm font-light mb-6">
            A curated selection of our most profound compositions, designed to leave an indelible mark on the senses.
            Crafted with rare botanicals and age-old techniques.
          </p>
          <a class="text-primary border-b border-primary pb-1 font-label text-[10px] uppercase tracking-widest" href="#"
            >Explore Heritage</a
          >
        </div>
      </div>

      <!-- Secondary Stacks -->
