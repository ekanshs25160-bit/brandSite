          <div class="mt-4 md:mt-6 flex justify-between items-end">
            <div>
              <span class="font-label text-[10px] uppercase tracking-widest text-secondary mb-1 block"
                >Best Seller</span
              >
              <h3 class="font-headline text-xl">Saffron Dusk</h3>
            </div>
            <span class="text-primary font-light">₹8,500</span>
          </div>
        </div>

        <div class="group pt-8 border-t border-outline-variant/15">
