<section class="relative h-screen w-full flex items-center justify-center overflow-hidden">
  <div class="absolute inset-0 z-0">
    {% if section.settings.image %}
      <img class="w-full h-full object-cover" src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.title }}">
    {% else %}
      <img class="w-full h-full object-cover" src="{{ 'hero-perfume.png' | asset_url }}" alt="Hero Image">
    {% endif %}
    <div class="absolute inset-0 hero-gradient"></div>
  </div>
  <div class="relative z-10 text-center text-white px-4 md:px-6">
    <h1 class="font-headline text-4xl sm:text-5xl md:text-7xl lg:text-8xl tracking-[0.1em] mb-6 md:mb-8 font-light italic">
      {{ section.settings.title }}
    </h1>
    <div class="flex justify-center">
      <button class="bg-primary text-on-primary px-8 md:px-12 py-3 md:py-4 text-xs font-label uppercase tracking-widest hover:bg-neutral-800 transition-all duration-300">
        {{ section.settings.button_label }}
      </button>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Aromaras Hero V3",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Art of Modern Attar"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Try the Discovery Set"
    }
  ],
  "presets": [
    {
      "name": "Aromaras Hero V3"
    }
  ]
}
{% endschema %}
