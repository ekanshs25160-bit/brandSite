<section class="aromaras-icons container">
  <div class="section-header">
    <h2 class="display-md">{{ section.settings.title }}</h2>
    <p class="body-md">{{ section.settings.description }}</p>
  </div>
  
  <div class="icons-grid">
    {% for block in section.blocks %}
      <div class="icon-card">
        <div class="card-image-wrapper">
          <img src="{{ block.settings.image | asset_url }}" alt="{{ block.settings.title }}" class="card-image">
        </div>
        <div class="card-content">
          <h3 class="headline-sm">{{ block.settings.title }}</h3>
          <p class="body-sm">{{ block.settings.subtitle }}</p>
          <a href="{{ block.settings.link }}" class="button-text">Explore</a>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .aromaras-icons {
    padding: 100px 0;
  }

  .section-header {
    text-align: center;
    margin-bottom: 80px;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .section-header h2 {
    font-size: 3rem;
    margin-bottom: 1.5rem;
  }

  .icons-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 40px;
  }

  .icon-card {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .card-image-wrapper {
    aspect-ratio: 4/5;
    overflow: hidden;
  }

  .card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .icon-card:hover .card-image {
    transform: scale(1.05);
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .button-text {
    text-decoration: underline;
    text-underline-offset: 4px;
    color: var(--color-primary);
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @media (max-width: 768px) {
    .icons-grid {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Aromaras Signature Icons",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Signature Icons"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A curated selection of our most profound compositions, designed to leave an indelible mark on the senses."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
        {
          "type": "text",
          "id": "image",
          "label": "Image Filename (in assets)"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Aromaras Signature Icons",
      "blocks": [
        {
          "type": "product",
          "settings": {
            "title": "Saffron Dusk",
            "subtitle": "Warm, spicy, and deeply mysterious.",
            "image": "saffron-dusk.png"
          }
        },
        {
          "type": "product",
          "settings": {
            "title": "Oudh Imperial",
            "subtitle": "Rare oudh blended with sacred resins.",
            "image": "saffron-dusk.png"
          }
        }
      ]
    }
  ]
}
{% endschema %}
