[
  {
    "name": "theme_info",
    "theme_name": "Aromaras Brand Site",
    "theme_version": "1.0.0",
    "theme_author": "Antigravity",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Brand Identity",
    "settings": [
      {
        "type": "header",
        "content": "Brand Colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Color",
        "default": "#1a1c1b"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary Color",
        "default": "#775a19"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Global Background",
        "default": "#faf9f7"
      },
      {
        "type": "header",
        "content": "Brand Typography"
      },
      {
        "type": "font_picker",
        "id": "font_headline",
        "label": "Headline Font (Serif)",
        "default": "eb_garamond_n4"
      },
      {
        "type": "font_picker",
        "id": "font_functional",
        "label": "Functional Font (Sans)",
        "default": "montserrat_n4"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Base Body Font"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page Width",
        "options": [
          { "value": "90rem", "label": "Narrow" },
          { "value": "110rem", "label": "Wide" },
          { "value": "120rem", "label": "Extra Wide" }
        ],
        "default": "110rem"
      },
      {
        "type": "range",
        "id": "grid_gap",
        "min": 10,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Grid Gap",
        "default": 24
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "Background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "Foreground"
      }
    ]
  }
]
